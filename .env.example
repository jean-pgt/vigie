# Vigie — integrations. Every one is optional: leave it empty and its cards and tabs disappear.
# Use read-only accounts and tokens everywhere.

PORT=8080
TZ=Europe/Paris
# CONFIG=/config/config.yaml        (default in Docker; /etc/vigie/config.yaml with the LXC install)
# DEMO=1                            fictional data, no source contacted

# OPNsense: System → Access → Users → API keys (a user with read access to Diagnostics, Interfaces, Routes, Firewall log)
OPNSENSE_URL=
OPNSENSE_KEY=
OPNSENSE_SECRET=

# Cisco IOS switch, SSH, read-only account (show commands only)
CISCO_HOST=
CISCO_USER=
CISCO_PASSWORD=

# Proxmox VE: API token with the PVEAuditor role (Datacenter → Permissions → API Tokens)
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=

# Proxmox Backup Server: API token with the DatastoreAudit role
PBS_URL=
PBS_DATASTORE=
PBS_TOKEN_ID=
PBS_TOKEN_SECRET=

# AdGuard Home (an account that can read statistics)
ADGUARD_URL=
ADGUARD_USER=
ADGUARD_PASSWORD=

# Uptime Kuma: public status page (slug in config.yaml) and an API key for certificate expiry (/metrics)
KUMA_URL=
KUMA_API_KEY=

# Beszel hub (a read-only user)
BESZEL_URL=
BESZEL_EMAIL=
BESZEL_PASSWORD=

# Zoraxy reverse proxy
ZORAXY_URL=
ZORAXY_USER=
ZORAXY_PASSWORD=

# Cloudflare: token with "Zone → Analytics → Read"
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=

# Authentik: token of a service account allowed to read events (sign-ins on the Security tab)
AUTHENTIK_URL=
AUTHENTIK_TOKEN=

# Media and download apps
JELLYFIN_URL=
JELLYFIN_API_KEY=
PLEX_URL=
PLEX_TOKEN=
JELLYSEERR_URL=
JELLYSEERR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
LIDARR_URL=
LIDARR_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=

# E-mail when a never-seen device joins the network (port 465 = SSL, otherwise STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERTE_A=
